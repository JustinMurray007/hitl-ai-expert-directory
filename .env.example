# Supabase credentials (leave blank for local Demo Mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin review secret token (for /admin review queue)
ADMIN_REVIEW_TOKEN=hitl-admin-secret-2026

# Canonical site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Payment Links (public URLs only — never put a Stripe secret key here).
# When a link is unset, that plan button on /apply scrolls to the application form.
NEXT_PUBLIC_STRIPE_LINK_BASIC_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_BASIC_YEARLY=
NEXT_PUBLIC_STRIPE_LINK_FEATURED_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_FEATURED_YEARLY=
NEXT_PUBLIC_STRIPE_LINK_PREMIUM_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_PREMIUM_YEARLY=
