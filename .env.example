# Supabase credentials (leave blank for local Demo Mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin review token for /admin and review actions. Required. There is no default.
# Generate a long random value. Store it as an encrypted Cloudflare Pages variable.
# /admin stays closed, and review actions fail, when this is empty.
ADMIN_REVIEW_TOKEN=

# Canonical site URL. Used for Checkout success, cancel, and Customer Portal return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true only after STRIPE_SECRET_KEY is configured on the server (Cloudflare).
# When this is not true, plan buttons on /apply scroll to the application form.
NEXT_PUBLIC_STRIPE_CHECKOUT_ENABLED=false

# Restricted Stripe API key (rk_test_… in a sandbox, rk_live_… only in production secrets).
# Prefer a restricted key over a secret key (sk_). Never commit a real key.
# Suggested permissions: Checkout Sessions write, Customers write, Subscriptions write,
# Billing Portal sessions write, Prices read, Products read, Invoices read.
# Store this with `wrangler secret put` or the Cloudflare dashboard, not in git.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_…) for the deployed endpoint. Different from `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Must stay false. Automatic tax is not sent to Stripe in this build, even if set to true,
# until a Stripe Tax registration is active. Prices are tax-exclusive. The business is a
# California sole proprietorship and has no confirmed registration.
STRIPE_AUTOMATIC_TAX=false

# Bearer token for POST /api/stripe/limit-expired (Cloudflare Cron or a manual call).
CRON_SECRET=

# Tally signing secret for POST /api/tally/webhook (the apply form on /apply).
# In Tally: the apply form → Integrations → Webhooks → endpoint
# https://findaipros.com/api/tally/webhook → copy the signing secret.
# Cloudflare Pages encrypted Production variable. Never commit the real value.
# Run db/migration_tally_submissions.sql before the first delivery.
TALLY_SIGNING_SECRET=

# Cloudflare Pages deploy hook. Secret. Leave unset locally.
# Create it in the Pages project: Settings → Builds → Deploy hooks, branch master.
# Set the URL as an encrypted Production environment variable so Pages Functions
# can read it. When unset, publish/plan/expiry actions log and continue.
# Never commit the real URL.
CLOUDFLARE_DEPLOY_HOOK_URL=
